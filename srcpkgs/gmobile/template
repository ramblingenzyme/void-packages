# Template file for 'gmobile'
pkgname=gmobile
version=0.7.0
revision=1
build_style=meson
build_helper="gir"
configure_args="$(vopt_bool gir introspection)
 $(vopt_bool vala vapi)
 $(vopt_bool gtk_doc)
 -Dexamples=false
 -Dtests=false
 -Dhwdb=true"
hostmakedepends="pkg-config glib-devel $(vopt_if vala 'vala')
 $(vopt_if gtk_doc gtk-doc)"
makedepends="glib-devel json-glib-devel"
short_desc="Library with helpers for mobile devices"
maintainer="Jan Christian Grünhage <jan.christian@gruenhage.xyz>"
license="LGPL-2.1-or-later"
homepage="https://gitlab.gnome.org/World/Phosh/gmobile"
distfiles="${homepage}/-/archive/v${version}/${pkgname}-v${version}.tar.gz"
checksum=5baa60d539d06ac582fc8dc9f50263b30205caf599eb4c64fcce3b11e85a1aca

build_options="gir vala gtk_doc"
build_options_default="gir vala"

gmobile-devel_package() {
	depends="${makedepends} ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
		if [ "$build_option_gir" ]; then
			vmove usr/share/gir-1.0
		fi
		if [ "$build_option_vala" ]; then
			vmove usr/share/vala
		fi
		if [ "$build_option_gtk_doc" ]; then
			vmove usr/share/gtk-doc
		fi
	}
}
